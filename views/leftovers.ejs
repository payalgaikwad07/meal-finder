<%- include('partials/header', { title: 'What Can I Cook? - YumPlan' }) %>

<main class="dashboard-container">
  
  <!-- MAIN CONTAINER (Hidden when loading) -->
  <div id="leftovers-form-container" class="detail-container" style="max-width: 600px; margin: 0 auto; padding: 3rem;">
    <div style="text-align: center; margin-bottom: 2rem;">
      <div style="font-size: 3.5rem; margin-bottom: 1rem;">🍳</div>
      <h1 style="color: var(--secondary); font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem;">What Can I Cook?</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Enter the ingredients currently in your fridge, and we'll suggest recipes you can make right now!</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/leftovers/suggest" method="POST" onsubmit="showLoader()" class="auth-form">
      <div class="form-group">
        <label for="ingredientsInput" style="font-size: 1rem; font-weight: 700; color: var(--secondary); margin-bottom: 10px; display: block;">
          Ingredients (2 to 5 items)
        </label>
        <input 
          type="text" 
          id="ingredientsInput" 
          name="ingredients" 
          placeholder="e.g. chicken, potato, onions, garlic" 
          required 
          style="width: 100%; border: 1.5px solid var(--border); border-radius: var(--radius); padding: 14px 20px; font-size: 1rem;"
        />
        <small class="form-text" style="display: block; margin-top: 8px; color: var(--text-muted);">
          Separate ingredients with commas. We will match these against real recipes and generate AI suggestions!
        </small>
      </div>

      <button type="submit" class="btn btn-primary btn-block" style="padding: 14px;">
        Generate Recipe Matches 🚀
      </button>
    </form>
  </div>

  <!-- STUNNING LOADING SCREEN (Shown on submit) -->
  <div id="leftovers-loader" class="detail-container" style="display: none; max-width: 600px; margin: 0 auto; padding: 4rem 2rem; text-align: center;">
    <div class="spinner-loader" style="margin: 0 auto 2rem; width: 60px; height: 60px; border: 6px solid var(--primary-light); border-top-color: var(--primary); border-radius: 50%; animation: spin 1s infinite linear;"></div>
    <h2 style="color: var(--secondary); font-weight: 800; margin-bottom: 0.8rem; font-size: 1.6rem;">Consulting AI Chef...</h2>
    <p style="color: var(--text-muted); font-size: 1.05rem; max-width: 400px; margin: 0 auto 1.5rem; line-height: 1.7;">
      Scanning our recipe database for matches and generating creative AI recipe suggestions. This will take a moment!
    </p>
    <div style="background: var(--bg); padding: 12px 20px; border-radius: 8px; display: inline-block; font-size: 0.85rem; color: var(--text-muted); border: 1px solid var(--border);">
      🔍 Querying ingredient indexes &bull; 🧠 Call Gemini 1.5 Flash
    </div>
  </div>

</main>

<style>
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  function showLoader() {
    // Hide the input form card
    document.getElementById('leftovers-form-container').style.display = 'none';
    // Show the loading card
    document.getElementById('leftovers-loader').style.display = 'block';
  }
</script>

<%- include('partials/footer') %>
