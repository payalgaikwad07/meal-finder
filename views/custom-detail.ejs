<%- include('partials/header', { title: recipe.meal_name + ' - YumPlan' }) %>

<div class="dashboard-header" style="margin-bottom: 2rem;">
  <div>
    <h1><%= recipe.meal_name %></h1>
    <p class="subtitle">
      <% if (recipe.recipe_details && recipe.recipe_details.description) { %>
        <%= recipe.recipe_details.description %>
      <% } else { %>
        AI Suggested Custom Recipe
      <% } %>
    </p>
  </div>
  <% 
    let backUrl = '/';
    if (typeof source !== 'undefined') {
      if (source === 'wishlist') backUrl = '/wishlist';
      else if (source === 'cookbook') backUrl = '/cookbook';
    }
  %>
  <a href="<%= backUrl %>" class="btn btn-secondary">&larr; Back to <%= typeof source !== 'undefined' ? source.charAt(0).toUpperCase() + source.slice(1) : 'Home' %></a>
</div>

<main class="detail-container">
  <div class="detail-row">
    
    <!-- LEFT SIDE: IMAGE -->
    <div class="detail-img-container">
      <span class="badge" style="position: absolute; top: 16px; left: 16px; background: var(--primary); color: white; padding: 6px 14px; font-size: 0.85rem; border-radius: var(--radius-full); z-index: 5; font-weight: 700;">
        AI Creation
      </span>
      <img src="<%= recipe.meal_thumb || 'https://images.unsplash.com/photo-1495521821757-a1efb6729352?q=80&w=600&auto=format&fit=crop' %>" alt="<%= recipe.meal_name %>" class="detail-img" />
      
      <div style="margin-top: 1.5rem; display: flex; gap: 10px; flex-wrap: wrap;">
        <span class="category" style="font-size: 0.9rem; padding: 6px 14px; background: var(--primary-light); color: var(--primary);">AI Custom</span>
        <span class="area" style="font-size: 0.9rem; padding: 6px 14px; background: var(--secondary-light); color: var(--secondary);">Leftovers</span>
      </div>
    </div>

    <!-- RIGHT SIDE: INGREDIENTS -->
    <div class="detail-info">
      <h2>Ingredients</h2>
      <ul style="list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; padding: 0;">
        <% if (recipe.recipe_details && Array.isArray(recipe.recipe_details.ingredients)) { %>
          <% recipe.recipe_details.ingredients.forEach(function(ing) { %>
            <li style="display: flex; align-items: center; gap: 10px; background: var(--bg); padding: 10px 16px; border-radius: var(--radius-full); font-size: 0.95rem; border: 1px solid var(--border);">
              <span style="color: var(--primary); font-weight: bold; font-size: 1.2rem;">&bull;</span>
              <span><%= ing %></span>
            </li>
          <% }); %>
        <% } else { %>
          <li>No ingredients listed.</li>
        <% } %>
      </ul>
    </div>

  </div>

  <!-- INSTRUCTIONS (FULL WIDTH BELOW) -->
  <div class="instructions-section" style="margin-top: 2rem; border-top: 2px solid var(--border); padding-top: 1.5rem;">
    <h2 style="margin-bottom: 1rem; color: var(--secondary);">Cooking Instructions</h2>
    <p class="detail-instructions" style="white-space: pre-line; line-height: 1.8; font-size: 1.05rem;">
      <% if (recipe.recipe_details && recipe.recipe_details.instructions) { %>
        <%= recipe.recipe_details.instructions %>
      <% } else { %>
        No instructions listed.
      <% } %>
    </p>
  </div>
</main>

<%- include('partials/footer') %>
