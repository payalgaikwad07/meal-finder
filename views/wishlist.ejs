<%- include('partials/header', { title: 'My Wishlist - YumPlan' }) %>

<main class="dashboard-container">
  <div class="planner-header">
    <div>
      <h1>My Wishlist</h1>
      <p class="subtitle">Recipes you want to cook soon</p>
    </div>
    <div class="planner-actions">
      <a href="/wishlist/shopping-list" class="btn btn-success">
        🛒 Generate Shopping List
      </a>
    </div>
  </div>

  <div id="wishlist-grid">
    <% if (!wishlist || wishlist.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">📝</div>
        <h3>Your wishlist is empty</h3>
        <p>Browse search results and click "Add to Wishlist" to queue up recipes you want to cook.</p>
        <a href="/" class="btn btn-secondary">Search Recipes</a>
      </div>
    <% } else { %>
      <div class="cards">
        <% wishlist.forEach(function(item) { %>
          <div class="card" id="wish-card-<%= item.id %>">
            <% if (item.is_ai_generated) { %>
              <span class="badge" style="position: absolute; top: 12px; left: 12px; background: var(--primary); color: white; padding: 4px 10px; font-size: 0.75rem; border-radius: var(--radius-full); z-index: 5;">
                AI Suggestion
              </span>
            <% } %>

            <img src="<%= item.meal_thumb || 'https://images.unsplash.com/photo-1495521821757-a1efb6729352?q=80&w=400&auto=format&fit=crop' %>" alt="<%= item.meal_name %>" />
            
            <div class="card-body">
              <h2><%= item.meal_name %></h2>
              
              <div class="btn-group" style="margin-top: 1rem; display: flex; gap: 8px;">
                <% 
                  const viewUrl = item.is_ai_generated 
                    ? `/recipe/custom/${item.id}?source=wishlist` 
                    : `/meal/${item.meal_id}`;
                %>
                <a href="<%= viewUrl %>" class="btn btn-primary btn-sm" style="flex: 1;">📖 View</a>
                <button onclick="removeWishlistItem('<%= item.id %>')" class="btn btn-danger btn-sm" style="flex: 1;">
                  🗑️ Remove
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</main>

<script>
  /**
   * AJAX removal of a wishlist item.
   */
  async function removeWishlistItem(wishlistId) {
    const card = document.getElementById(`wish-card-${wishlistId}`);
    if (!card) return;

    const btn = card.querySelector('.btn-danger');
    btn.disabled = true;
    btn.innerText = 'Removing...';

    try {
      const response = await fetch(`/wishlist/${wishlistId}`, {
        method: 'DELETE',
      });
      const data = await response.json();

      if (response.ok && data.success) {
        // Fade out transition
        card.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.9)';
        
        setTimeout(() => {
          card.remove();
          
          // Re-evaluate if wishlist is now empty
          const remainingCards = document.querySelectorAll('.card');
          if (remainingCards.length === 0) {
            const grid = document.getElementById('wishlist-grid');
            if (grid) {
              grid.innerHTML = `
                <div class="empty-state">
                  <div class="empty-icon">📝</div>
                  <h3>Your wishlist is empty</h3>
                  <p>Browse search results and click "Add to Wishlist" to queue up recipes you want to cook.</p>
                  <a href="/" class="btn btn-secondary">Search Recipes</a>
                </div>
              `;
            }
          }
        }, 300);
      } else {
        alert(data.error || 'Failed to remove from wishlist.');
        btn.disabled = false;
        btn.innerText = '🗑️ Remove';
      }
    } catch (error) {
      console.error('Error removing from wishlist:', error);
      alert('A connection error occurred. Please try again.');
      btn.disabled = false;
      btn.innerText = '🗑️ Remove';
    }
  }
</script>

<%- include('partials/footer') %>
