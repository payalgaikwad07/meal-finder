<%- include('partials/header', { title: 'Search Results - YumPlan' }) %>

<div class="dashboard-header" style="margin-bottom: 2rem;">
  <div>
    <h1>Recipe Discoveries</h1>
    <% if (typeof query !== 'undefined' && query) { %>
      <p class="subtitle">Showing results for: <strong><%= query %></strong></p>
    <% } %>
  </div>
  <a href="/" class="btn btn-secondary">&larr; Back to Search</a>
</div>

<!-- ERROR MESSAGE (shown only if error exists) -->
<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger" style="margin-bottom: 2rem;"><%= error %></div>
<% } %>

<!-- NO RESULTS MESSAGE -->
<% if (!meals || meals.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">🔍</div>
    <h3>No recipes found</h3>
    <p>We couldn't find any matches. Try a different search term or explore another cuisine!</p>
    <a href="/" class="btn btn-primary">Try Another Search</a>
  </div>

<% } else { %>

  <!-- MEAL CARDS GRID -->
  <div class="cards">
    <% meals.forEach(function(meal) { %>
      <% 
        const isFav = typeof savedMealIds !== 'undefined' && savedMealIds.includes(meal.idMeal);
      %>
      <div class="card">
        
        <!-- HEART FAVORITE TOGGLE -->
        <button 
          class="btn-heart <%= isFav ? 'favorited' : '' %>" 
          onclick="toggleFavorite(this, '<%= meal.idMeal %>', '<%= meal.strMeal.replace(/'/g, "\\'") %>', '<%= meal.strMealThumb %>')"
          title="<%= isFav ? 'Remove from Cookbook' : 'Save to Cookbook' %>"
        >
          <%= isFav ? '♥' : '♡' %>
        </button>

        <!-- MEAL IMAGE -->
        <img src="<%= meal.strMealThumb %>" alt="<%= meal.strMeal %>" />

        <div class="card-body">
          <div>
            <h2><%= meal.strMeal %></h2>

            <div class="card-meta">
              <% if (meal.strCategory) { %>
                <span class="category"><%= meal.strCategory %></span>
              <% } %>

              <% if (meal.strArea) { %>
                <span class="area"><%= meal.strArea %></span>
              <% } %>
            </div>

            <!-- INSTRUCTIONS EXCERPT -->
            <% if (meal.strInstructions) { %>
              <p class="instructions"><%= meal.strInstructions.substring(0, 110) %>...</p>
            <% } %>
          </div>

          <!-- VIEW FULL RECIPE & WISHLIST BUTTONS -->
          <div class="btn-group" style="display: flex; flex-direction: column; gap: 8px; margin-top: 10px;">
            <a href="/meal/<%= meal.idMeal %>" class="btn btn-primary btn-sm btn-block">📖 View Recipe</a>
            <button 
              onclick="toggleWishlist(this, '<%= meal.idMeal %>', '<%= meal.strMeal.replace(/'/g, "\\'") %>', '<%= meal.strMealThumb %>')" 
              class="btn btn-secondary btn-sm btn-block wishlist-toggle-btn <%= typeof wishlistMealIds !== 'undefined' && wishlistMealIds.includes(meal.idMeal) ? 'in-wishlist' : '' %>"
            >
              <%= typeof wishlistMealIds !== 'undefined' && wishlistMealIds.includes(meal.idMeal) ? '📋 In Wishlist' : '➕ Add to Wishlist' %>
            </button>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

<% } %>

<script src="/scripts/main.js"></script>

<%- include('partials/footer') %>
