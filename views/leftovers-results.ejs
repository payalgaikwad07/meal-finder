<%- include('partials/header', { title: 'Leftovers Recipes Matches - YumPlan' }) %>

<div class="dashboard-header" style="margin-bottom: 2.5rem;">
  <div>
    <h1>Leftovers Recipe Finder</h1>
    <p class="subtitle">Suggestions based on: <strong><%= query %></strong></p>
  </div>
  <a href="/leftovers" class="btn btn-secondary">&larr; Change Ingredients</a>
</div>

<!-- ==========================================
     SECTION 1: REAL RECIPE MATCHES
     ========================================== -->
<section style="margin-bottom: 4rem;">
  <h2 style="color: var(--secondary); font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px;">
    <span>🥘</span> Real Recipe Database Matches
  </h2>

  <% if (!realMatches || realMatches.length === 0) { %>
    <div class="empty-state" style="padding: 2.5rem; margin-bottom: 2rem;">
      <div class="empty-icon">🍲</div>
      <h3>No exact database matches</h3>
      <p>We couldn't find database recipes containing multiple matching ingredients. Try our AI-generated suggestions below!</p>
    </div>
  <% } else { %>
    <div class="cards">
      <% realMatches.forEach(function(meal) { %>
        <% 
          const isFav = typeof savedMealIds !== 'undefined' && savedMealIds.includes(meal.idMeal);
          const isWish = typeof wishlistMealIds !== 'undefined' && wishlistMealIds.includes(meal.idMeal);
        %>
        <div class="card">
          <!-- HEART FAVORITE TOGGLE -->
          <button 
            class="btn-heart <%= isFav ? 'favorited' : '' %>" 
            onclick="toggleFavorite(this, '<%= meal.idMeal %>', '<%= meal.strMeal.replace(/'/g, "\\'") %>', '<%= meal.strMealThumb %>')"
            title="<%= isFav ? 'Remove from Cookbook' : 'Save to Cookbook' %>"
          >
            <%= isFav ? '♥' : '♡' %>
          </button>

          <img src="<%= meal.strMealThumb %>" alt="<%= meal.strMeal %>" />

          <div class="card-body">
            <div>
              <h2><%= meal.strMeal %></h2>

              <span class="badge" style="background: var(--success-light); color: var(--success); font-weight: 700; font-size: 0.8rem; padding: 4px 12px; border-radius: var(--radius-full); display: inline-block; margin-bottom: 12px;">
                Matches <%= meal.matchesCount %> of <%= totalIngredientsCount %> ingredients
              </span>
            </div>

            <div class="btn-group" style="display: flex; flex-direction: column; gap: 8px; margin-top: 10px;">
              <a href="/meal/<%= meal.idMeal %>" class="btn btn-primary btn-sm btn-block">📖 View Recipe</a>
              
              <button 
                onclick="toggleWishlist(this, '<%= meal.idMeal %>', '<%= meal.strMeal.replace(/'/g, "\\'") %>', '<%= meal.strMealThumb %>')" 
                class="btn btn-secondary btn-sm btn-block wishlist-toggle-btn <%= isWish ? 'in-wishlist' : '' %>"
              >
                <%= isWish ? '📋 In Wishlist' : '➕ Add to Wishlist' %>
              </button>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</section>

<!-- ==========================================
     SECTION 2: AI RECIPE SUGGESTIONS (GEMINI)
     ========================================== -->
<section style="margin-bottom: 3rem; border-top: 2px solid var(--border); padding-top: 3rem;">
  <h2 style="color: var(--secondary); font-weight: 800; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 8px;">
    <span>🧠</span> AI Chef Creative Suggestions
  </h2>
  <p class="subtitle" style="margin-bottom: 2rem;">Custom recipes generated by Gemini 1.5 Flash using your leftovers</p>

  <% if (!aiSuggestions || aiSuggestions.length === 0) { %>
    <div class="empty-state" style="border: 2px dashed #f8d7da; background: #fdf2f2;">
      <div class="empty-icon">🔌</div>
      <h3>AI suggestion is unavailable</h3>
      <p>Could not load AI recipe ideas. Please verify that <strong>GEMINI_API_KEY</strong> is defined in your `.env` file and try again.</p>
    </div>
  <% } else { %>
    <div class="ai-suggestions-list" style="display: grid; grid-template-columns: 1fr; gap: 3rem;">
      <% aiSuggestions.forEach(function(recipe, idx) { %>
        <div class="detail-container" style="border-left: 6px solid var(--primary); box-shadow: var(--shadow-lg);">
          
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; border-bottom: 1.5px solid var(--border); padding-bottom: 1rem; margin-bottom: 1.5rem;">
            <div>
              <span class="badge" style="background: var(--primary-light); color: var(--primary); font-weight: 800; padding: 4px 12px; border-radius: var(--radius-full); font-size: 0.8rem; margin-bottom: 0.5rem; display: inline-block;">
                AI CREATION
              </span>
              <h3 style="font-size: 1.6rem; font-weight: 800; color: var(--secondary);"><%= recipe.name %></h3>
              <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;"><%= recipe.description %></p>
            </div>
            
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              <button onclick="saveAICustomFavorite(this, <%= idx %>)" class="btn btn-secondary btn-sm" style="border: 1px solid var(--border); padding: 8px 16px;">
                💾 Save to Cookbook
              </button>
              <button onclick="addAICustomWishlist(this, <%= idx %>)" class="btn btn-primary btn-sm" style="padding: 8px 16px;">
                📋 Add to Wishlist
              </button>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; align-items: start;">
            <!-- INGREDIENTS -->
            <div style="background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem;">
              <h4 style="font-size: 1.1rem; color: var(--secondary); margin-bottom: 12px; border-bottom: 1px solid var(--border); padding-bottom: 6px;">Ingredients</h4>
              <ul style="list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 0.9rem;">
                <% recipe.ingredients.forEach(function(ing) { %>
                  <li style="display: flex; align-items: center; gap: 8px; color: var(--text);">
                    <span style="color: var(--primary); font-weight: bold;">&bull;</span> <%= ing %>
                  </li>
                <% }); %>
              </ul>
            </div>

            <!-- INSTRUCTIONS -->
            <div>
              <h4 style="font-size: 1.1rem; color: var(--secondary); margin-bottom: 12px;">Steps</h4>
              <p style="white-space: pre-line; line-height: 1.7; font-size: 0.95rem; color: var(--text);"><%= recipe.instructions %></p>
            </div>
          </div>

        </div>
      <% }); %>
    </div>
  <% } %>
</section>

<!-- Expose AI suggestions to window context for AJAX posts -->
<script>
  window.aiSuggestions = <%- JSON.stringify(aiSuggestions || []) %>;
</script>

<script src="/scripts/main.js"></script>

<%- include('partials/footer') %>
